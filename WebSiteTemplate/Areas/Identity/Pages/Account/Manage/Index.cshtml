@page
@model IndexModel
@{
    ViewData["Title"] = "Profil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="settings-card">
    <span class="glass-label">HESAP · PROFİL</span>
    <h2>Profil Bilgilerin</h2>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="profile-form" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" placeholder="Kullanıcı adı" disabled />
        </div>

        <div class="form-row-split mb-3">
            <div>
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" placeholder="Adınız" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Input.Surname" class="form-label"></label>
                <input asp-for="Input.Surname" class="form-control" placeholder="Soyadınız" />
                <span asp-validation-for="Input.Surname" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Input.PhoneNumber" class="form-label"></label>
            <div class="row g-2">
                <div class="col-4">
                    <select asp-for="Input.CountryCode" class="form-select">
                        <option value="+90">🇹🇷 +90</option>
                        <option value="+1">🇺🇸 +1</option>
                        <option value="+49">🇩🇪 +49</option>
                        <option value="+44">🇬🇧 +44</option>
                    </select>
                </div>
                <div class="col-8">
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="5XX XXX XX XX" />
                </div>
            </div>
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.ProfileImageUrl" class="form-label"></label>
            <input asp-for="Input.ProfileImageUrl" class="form-control" placeholder="https://..." />
            <span asp-validation-for="Input.ProfileImageUrl" class="text-danger"></span>
        </div>

        <button id="update-profile-button" type="submit" class="btn btn-primary w-100">Kaydet</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}