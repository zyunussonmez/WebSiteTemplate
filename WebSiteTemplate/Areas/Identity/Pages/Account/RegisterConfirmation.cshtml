@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Kayıt Onayı";
}

<div class="auth-wrapper">
    <div class="glass-card">
        <span class="glass-label">AUTH · KAYIT ONAYI</span>

        @if (Model.DisplayConfirmAccountLink)
        {
            <h2>Geliştirici Modu</h2>
            <p>Bu ortamda gerçek bir email gönderici yapılandırılmamış, bu yüzden onay linkini burada gösteriyoruz:</p>
            <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="btn btn-primary w-100">Hesabı Onayla</a>
        }
        else
        {
            <h2>Neredeyse Tamam</h2>
            <p>Hesabını onaylamak için email adresine gönderdiğimiz bağlantıya tıkla.</p>
            <div class="mt-3 text-center">
                <a asp-page="./Login">Giriş sayfasına dön</a>
            </div>
        }
    </div>
</div>